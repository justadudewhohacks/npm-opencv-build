{
  "name": "@u4/opencv-build",
  "version": "1.2.0",
  "license": "MIT",
  "exports": "./mod.ts",
  "tasks": {
    "dev": "deno run --watch main.ts"
  },
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@^0.41.3",
    "@denodnt/logger": "jsr:@deno-lib/logger@^1.1.6",
    "@std/assert": "jsr:@std/assert@^1.0.2",
    "@std/fmt": "jsr:@std/fmt@^1.0.0",
    "glob": "npm:glob@^13.0.0",
    "picocolors": "npm:picocolors@^1.1.1",
    "rimraf": "npm:rimraf@^6.1.2"
  },
  "node": true,
  "lock": false,
  "exclude": ["vcpkg", "build", "dist", "npm"],
  "publish": {
    "include": [
      "mod.ts",
      "main.ts",
      "src/**/*.ts",
      "README.md",
      "CHANGELOG.md",
      "deno.json"
    ],
    "exclude": [
      "src/**/*_test.ts"
    ]
  }
}
